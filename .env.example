# Copy to .env and fill in ONE key (or two different ones to use a different judge model).
# Auto-detect order: Anthropic -> OpenAI -> Gemini -> OpenAI-compatible -> offline mock.

# GEMINI_API_KEY=...            # free tier: https://aistudio.google.com/apikey
# ANTHROPIC_API_KEY=...
# OPENAI_API_KEY=...

# Any OpenAI-compatible API (Groq has a free tier: https://console.groq.com/keys)
# OPENAI_COMPAT_API_KEY=...
# OPENAI_COMPAT_BASE_URL=https://api.groq.com/openai/v1

# Optional: choose provider/model per role. Using a DIFFERENT model as judge reduces self-grading bias.
# LF_GEN_PROVIDER=gemini
# LF_GEN_MODEL=gemini-3.6-flash      # or gemini-3.5-flash-lite (separate free quota)
# LF_JUDGE_PROVIDER=openai_compat
# LF_JUDGE_MODEL=openai/gpt-oss-120b

# Parallel judge calls. Use 1 if your free tier hits rate limits (HTTP 429).
# LF_JUDGE_WORKERS=2
